generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  role      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ContentItem {
  id          Int       @id @default(autoincrement())
  module      String    @db.VarChar(30)
  section     String    @db.VarChar(50)
  title       String    @db.VarChar(180)
  summary     String?   @db.Text
  body        String    @db.Text
  imageUrl    String?   @map("image_url") @db.LongText
  tags        String?   @db.VarChar(300)
  status      String    @default("published") @db.VarChar(20)
  authorRole  String    @map("author_role") @db.VarChar(20)
  authorName  String    @map("author_name") @db.VarChar(100)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([module, section, status])
  @@map("content_items")
}

model FinanceTransaction {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(20)
  date       DateTime @db.Date
  category   String   @db.VarChar(80)
  detail     String   @db.VarChar(180)
  note       String?  @db.VarChar(300)
  amount     Int
  authorRole String   @map("author_role") @db.VarChar(20)
  authorName String   @map("author_name") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([type, date])
  @@map("finance_transactions")
}
